PORT=3000
# MongoDB Atlas connection string (mongodb+srv://...). Allow the host's IP in Atlas Network Access.
MONGODB_URI=mongodb://localhost:27017/messages
REDIS_URL=redis://localhost:6379
# Optional extra cross-origin clients (the bundled web app is same-origin at /api).
CORS_ORIGINS=

# One Clerk application for both agents and admins. Same keys as apps/web/.env.local.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Admins are Clerk user ids listed in services/api/src/config/admins.ts.
# Optional extra, comma-separated, without a code change:
ADMIN_CLERK_USER_IDS=

ABLY_API_KEY=

S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

CUSTOMER_JWT_SECRET=

CUSTOM_SMS_API_URL=
CUSTOM_SMS_API_KEY=

WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=

GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_ID=

# Transactional email (Resend). Unset in dev = emails are only logged.
RESEND_API_KEY=
EMAIL_FROM=
# Public base URL of the deployed service, used for invite links.
WEB_BASE_URL=http://localhost:3000

# Push notifications (optional; unset = only logged)
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRODUCTION=false

APP_NAME=Messages
