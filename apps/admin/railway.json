{
  "$schema": "https://railway.app/railway.schema.json",
  "$comment": "Railway service settings: Root Directory = repo root; Config Path = apps/admin/railway.json.",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @messages/admin... build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @messages/admin start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
